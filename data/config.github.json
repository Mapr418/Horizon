      },
      {
        "name": "MIT News AI",
        "url": "https://news.mit.edu/topic/mitartificial-intelligence2-rss.xml",
        "enabled": true,
        "category": "company-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "category": "company-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "VentureBeat AI",
        "url": "https://venturebeat.com/category/ai/feed/",
        "enabled": true,
        "category": "company-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "The Decoder",
        "url": "https://the-decoder.com/feed/",
        "enabled": true,
        "category": "company-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "arXiv cs.AI",
        "url": "https://rss.arxiv.org/rss/cs.AI",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news",
        "max_results": 2
      },
      {
        "name": "arXiv cs.LG",
        "url": "https://rss.arxiv.org/rss/cs.LG",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news",
        "max_results": 2
      },
      {
        "name": "arXiv cs.CL",
        "url": "https://rss.arxiv.org/rss/cs.CL",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news",
        "max_results": 2
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 20,
          "category": "community-discussion",
          "profile": "tech-news"
        },
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 8,
          "min_score": 30,
          "category": "community-discussion",
          "profile": "tech-news"
        },
        {
          "subreddit": "OpenAI",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 6,
          "min_score": 20,
          "category": "community-discussion",
          "profile": "tech-news"
        },
        {
          "subreddit": "ClaudeAI",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 6,
          "min_score": 20,
          "category": "community-discussion",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 4
    },
    "telegram": {
      "enabled": false
    },
    "twitter": {
      "enabled": false
    },
    "openbb": {
      "enabled": false
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "ai",
        "llm",
        "agent",
        "model",
        "rag",
        "deepseek",
        "openai",
        "claude",
        "gemini",
        "multimodal"
      ],
      "min_stars": 20,
      "max_items": 8,
      "fetch_readme": true,
      "readme_max_chars": 5000,
      "category": "open-source",
      "profile": "tech-news"
    },
    "gdelt": {
      "enabled": false
    },
    "google_news": {
      "enabled": true,
      "query": "(OpenAI OR Anthropic OR DeepMind OR Gemini OR GPT OR Claude OR \"large language model\" OR \"AI agent\" OR multimodal OR benchmark OR \"AI model\") (release OR launches OR announces OR research OR benchmark OR paper OR agent OR safety OR open-source) -stock -shares -rally -smartphone -TV",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 6,
      "category": "frontier-news",
      "profile": "tech-news",
      "content_extractor": "trafilatura"
    }
  },
  "collection": {
    "time_window_hours": 72
  },
  "digest": {
    "max_items": 10,
    "profile_order": [
      "tech-news"
    ],
    "category_groups": {
      "company-release": {
        "name": "公司发布与官方动态",
        "limit": 3,
        "categories": [
          "company-release",
          "company-news"
        ]
      },
      "open-source": {
        "name": "开源社区热度",
        "limit": 3,
        "categories": [
          "open-source"
        ]
      },
      "community-discussion": {
        "name": "技术社区讨论",
        "limit": 2,
        "categories": [
          "community-discussion"
        ]
      },
      "papers": {
        "name": "论文补充",
        "limit": 2,
        "categories": [
          "papers"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "noreply@example.com"
  },
  "webhook": {
    "enabled": false
  },
  "extractors": {
    "trafilatura": {
      "type": "trafilatura",
      "favor_recall": true
    }
  }
}
