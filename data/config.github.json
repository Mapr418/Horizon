{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.25,
    "max_tokens": 12000,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 2.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 10,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "frontier-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google DeepMind Blog",
        "url": "https://deepmind.google/blog/feed/basic/",
        "enabled": true,
        "category": "frontier-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google AI Blog",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
        "category": "frontier-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "frontier-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "MIT News AI",
        "url": "https://news.mit.edu/topic/mitartificial-intelligence2-rss.xml",
        "enabled": true,
        "category": "frontier-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "category": "frontier-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "VentureBeat AI",
        "url": "https://venturebeat.com/category/ai/feed/",
        "enabled": true,
        "category": "frontier-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "The Decoder",
        "url": "https://the-decoder.com/feed/",
        "enabled": true,
        "category": "frontier-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "arXiv cs.AI",
        "url": "https://rss.arxiv.org/rss/cs.AI",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news",
        "max_results": 5
      },
      {
        "name": "arXiv cs.LG",
        "url": "https://rss.arxiv.org/rss/cs.LG",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news",
        "max_results": 5
      },
      {
        "name": "arXiv cs.CL",
        "url": "https://rss.arxiv.org/rss/cs.CL",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news",
        "max_results": 3
      }
    ],
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    },
    "twitter": {
      "enabled": false
    },
    "openbb": {
      "enabled": false
    },
    "ossinsight": {
      "enabled": false
    },
    "gdelt": {
      "enabled": false
    },
    "google_news": {
      "enabled": true,
      "query": "(OpenAI OR Anthropic OR DeepMind OR Gemini OR GPT OR Claude OR \"large language model\" OR \"AI agent\" OR multimodal OR benchmark OR \"AI model\") (release OR launches OR announces OR research OR benchmark OR paper OR agent OR safety OR open-source) -stock -shares -rally -smartphone -TV",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 6,
      "category": "frontier-news",
      "profile": "tech-news",
      "content_extractor": "trafilatura"
    }
  },
  "collection": {
    "time_window_hours": 72
  },
  "digest": {
    "max_items": 8,
    "profile_order": [
      "tech-news"
    ],
    "category_groups": {
      "frontier-news": {
        "name": "模型发布与行业前沿",
        "limit": 6,
        "categories": [
          "frontier-news"
        ]
      },
      "papers": {
        "name": "论文与研究突破",
        "limit": 4,
        "categories": [
          "papers"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "noreply@example.com"
  },
  "webhook": {
    "enabled": false
  },
  "extractors": {
    "trafilatura": {
      "type": "trafilatura",
      "favor_recall": true
    }
  }
}
