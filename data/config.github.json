{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.25,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.5,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 10,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "frontier-lab",
        "profile": "tech-news"
      },
      {
        "name": "Google DeepMind Blog",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "frontier-lab",
        "profile": "tech-news"
      },
      {
        "name": "Google AI",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
        "category": "frontier-lab",
        "profile": "tech-news"
      },
      {
        "name": "Google Research",
        "url": "https://research.google/blog/rss/",
        "enabled": true,
        "category": "research-lab",
        "profile": "tech-news"
      },
      {
        "name": "BAIR Blog",
        "url": "https://bair.berkeley.edu/blog/feed.xml",
        "enabled": true,
        "category": "research-lab",
        "profile": "tech-news"
      },
      {
        "name": "MIT News AI",
        "url": "https://news.mit.edu/topic/mitartificial-intelligence2-rss.xml",
        "enabled": true,
        "category": "research",
        "profile": "tech-news"
      },
      {
        "name": "arXiv AI",
        "url": "https://rss.arxiv.org/rss/cs.AI",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news"
      },
      {
        "name": "arXiv Machine Learning",
        "url": "https://rss.arxiv.org/rss/cs.LG",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news"
      },
      {
        "name": "arXiv NLP",
        "url": "https://rss.arxiv.org/rss/cs.CL",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news"
      },
      {
        "name": "Import AI",
        "url": "https://importai.substack.com/feed",
        "enabled": true,
        "category": "analysis",
        "profile": "tech-news"
      },
      {
        "name": "The Gradient",
        "url": "https://thegradient.pub/rss/",
        "enabled": true,
        "category": "analysis",
        "profile": "tech-news"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-engineering",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    },
    "twitter": {
      "enabled": false
    },
    "openbb": {
      "enabled": false
    },
    "ossinsight": {
      "enabled": false
    },
    "gdelt": {
      "enabled": false
    },
    "google_news": {
      "enabled": true,
      "query": "(OpenAI OR Anthropic OR DeepMind OR Gemini OR GPT OR Claude OR \"large language model\" OR \"AI model\")",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 30,
      "category": "frontier-news",
      "profile": "tech-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 12,
    "profile_order": [
      "tech-news"
    ],
    "category_groups": {
      "frontier-lab": {
        "name": "前沿实验室与模型发布",
        "limit": 5,
        "categories": [
          "frontier-lab"
        ]
      },
      "research": {
        "name": "论文与研究突破",
        "limit": 5,
        "categories": [
          "papers",
          "research",
          "research-lab"
        ]
      },
      "ai-engineering": {
        "name": "AI 工程与工具",
        "limit": 3,
        "categories": [
          "ai-engineering"
        ]
      },
      "analysis": {
        "name": "深度解读",
        "limit": 3,
        "categories": [
          "analysis"
        ]
      },
      "frontier-news": {
        "name": "行业前沿动态",
        "limit": 4,
        "categories": [
          "frontier-news"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 3
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "noreply@example.com"
  },
  "webhook": {
    "enabled": false
  }
}
