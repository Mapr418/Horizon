{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.25,
    "max_tokens": 12000,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 2.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "repo_search",
        "query": "topic:artificial-intelligence",
        "sort": "updated",
        "order": "desc",
        "max_results": 4,
        "min_stars": 500,
        "fetch_readme": true,
        "readme_max_chars": 5000,
        "enabled": true,
        "category": "open-source",
        "profile": "tech-news"
      },
      {
        "type": "repo_search",
        "query": "topic:llm",
        "sort": "updated",
        "order": "desc",
        "max_results": 4,
        "min_stars": 200,
        "fetch_readme": true,
        "readme_max_chars": 5000,
        "enabled": true,
        "category": "open-source",
        "profile": "tech-news"
      },
      {
        "type": "repo_search",
        "query": "topic:ai-agent",
        "sort": "updated",
        "order": "desc",
        "max_results": 4,
        "min_stars": 50,
        "fetch_readme": true,
        "readme_max_chars": 5000,
        "enabled": true,
        "category": "open-source",
        "profile": "tech-news"
      },
      {
        "type": "repo_search",
        "query": "topic:generative-ai",
        "sort": "updated",
        "order": "desc",
        "max_results": 3,
        "min_stars": 200,
        "fetch_readme": true,
        "readme_max_chars": 5000,
        "enabled": true,
        "category": "open-source",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "category": "company-release",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "anthropic-sdk-python",
        "enabled": true,
        "category": "company-release",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "deepseek-ai",
        "repo": "DeepSeek-V3",
        "enabled": true,
        "category": "company-release",
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 35,
      "min_score": 20,
      "category": "community-discussion",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "company-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Anthropic News",
        "url": "https://www.anthropic.com/news/rss.xml",
        "enabled": true,
        "category": "company-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google DeepMind Blog",
        "url": "https://deepmind.google/blog/feed/basic/",
        "enabled": true,
        "category": "company-news",
        "profile": "tech-news",
        "max_results": 3,
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google AI Blog",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
