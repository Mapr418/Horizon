{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.25,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 10,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "LLM Papers Search",
        "url": "https://export.arxiv.org/api/query?search_query=all:%22large%20language%20model%22&start=0&max_results=2&sortBy=submittedDate&sortOrder=descending",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news"
      },
      {
        "name": "AI Agents Papers Search",
        "url": "https://export.arxiv.org/api/query?search_query=all:%22AI%20agent%22&start=0&max_results=1&sortBy=submittedDate&sortOrder=descending",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news"
      },
      {
        "name": "Multimodal AI Papers Search",
        "url": "https://export.arxiv.org/api/query?search_query=all:%22multimodal%20model%22&start=0&max_results=1&sortBy=submittedDate&sortOrder=descending",
        "enabled": true,
        "category": "papers",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    },
    "twitter": {
      "enabled": false
    },
    "openbb": {
      "enabled": false
    },
    "ossinsight": {
      "enabled": false
    },
    "gdelt": {
      "enabled": false
    },
    "google_news": {
      "enabled": true,
      "query": "(OpenAI OR Anthropic OR DeepMind OR Gemini OR GPT OR Claude OR \"large language model\" OR \"AI agent\") (model OR release OR benchmark OR research OR paper OR agent)",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 6,
      "category": "frontier-news",
      "profile": "tech-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 8,
    "profile_order": [
      "tech-news"
    ],
    "category_groups": {
      "frontier-news": {
        "name": "模型发布与行业前沿",
        "limit": 6,
        "categories": [
          "frontier-news"
        ]
      },
      "papers": {
        "name": "论文与研究突破",
        "limit": 4,
        "categories": [
          "papers"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "noreply@example.com"
  },
  "webhook": {
    "enabled": false
  }
}
